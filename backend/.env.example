# Copy to .env and fill in values. Never commit .env.

# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (AICTE Central Repository) - Supabase session pooler (IPv4)
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Redis (cache + BullMQ job queue). For Upstash use the TCP URL: rediss://default:<token>@<host>.upstash.io:6379
# (not the REST URL). Leave empty to run validation jobs inline in the API process (local dev only).
REDIS_URL=redis://localhost:6379
# The API starts a validation worker itself; set to false when running `npm run dev:worker` separately.
WORKER_IN_API=true

# Supabase Auth (same Supabase project as DATABASE_URL)
# Disable public user sign-ups in Supabase Auth settings; accounts are provisioned by the role API.
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# Encryption & signing
# 32-byte base64 key for AES-256-GCM encryption of passport / OCI / FRRO numbers. Required to validate
# non-resident students. Generate once and share it across the team (data encrypted with one key
# cannot be read with another): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
CREDENTIAL_SIGNING_KEY=        # private key (PEM/JWK) for signed credentials & QR

# External integrations (mocked where APIs are not public)
APAAR_REGISTRY_URL=http://localhost:4100/mock/apaar
DIGILOCKER_URL=http://localhost:4100/mock/digilocker
AICTE_APPROVAL_URL=http://localhost:4100/mock/aicte-approval
NSP_URL=http://localhost:4100/mock/nsp
AISHE_URL=http://localhost:4100/mock/aishe

# Notifications
SMTP_URL=smtp://localhost:1025

# OpenTelemetry
OTEL_SERVICE_NAME=apaar-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
