# Copy to .env and fill in values. Never commit .env.

# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (AICTE Central Repository)
DATABASE_URL=postgresql://apaar:apaar@localhost:5432/apaar?schema=public

# Redis (cache + BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Keycloak (OAuth2 / OIDC)
KEYCLOAK_ISSUER=http://localhost:8080/realms/apaar
KEYCLOAK_AUDIENCE=apaar-api

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=apaar
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Encryption & signing
FIELD_ENCRYPTION_KEY=          # 32-byte base64 key for AES-256-GCM field encryption
CREDENTIAL_SIGNING_KEY=        # private key (PEM/JWK) for signed credentials & QR

# External integrations (mocked where APIs are not public)
APAAR_REGISTRY_URL=http://localhost:4100/mock/apaar
DIGILOCKER_URL=http://localhost:4100/mock/digilocker
AICTE_APPROVAL_URL=http://localhost:4100/mock/aicte-approval
NSP_URL=http://localhost:4100/mock/nsp
AISHE_URL=http://localhost:4100/mock/aishe

# Notifications
SMTP_URL=smtp://localhost:1025

# OpenTelemetry
OTEL_SERVICE_NAME=apaar-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
